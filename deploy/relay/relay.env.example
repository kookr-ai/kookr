# Kookr self-hosted relay environment.
# Copy to /etc/kookr/relay.env and fill secrets on the server.

PORT=8080
KOOKR_RELAY_BIND_HOST=127.0.0.1
KOOKR_RELAY_PUBLIC_ORIGIN=https://relay.example.com
KOOKR_RELAY_STATE_DB_PATH=/var/lib/kookr-relay/relay.sqlite

# Generate with: openssl rand -hex 32
KOOKR_RELAY_ADMIN_TOKEN=replace-with-64-hex-chars

# Optional hosted/account pairing path.
# Generate with: openssl rand -hex 32
# KOOKR_RELAY_ACCOUNT_TOKEN=replace-with-64-hex-chars
# KOOKR_RELAY_ACCOUNT_ID=self-hosted-owner
# Hosted relay terminal viewing stays disabled unless these production gates
# are intentionally enabled and monitored.
# KOOKR_HOSTED_RELAY_ENABLED=1
# KOOKR_HOSTED_RELAY_OPS_GATES_MET=1
# KOOKR_HOSTED_RELAY_OWNER=ops@example.com
# KOOKR_HOSTED_RELAY_ENVIRONMENT=production
# KOOKR_HOSTED_RELAY_TLS_EXPIRES_AT=2026-12-31T00:00:00.000Z
# KOOKR_RELAY_INCIDENT_ESCALATION_URL=https://pager.example.invalid/kookr-relay

# Safe default remains 24h. Uncomment to opt into the 31-day hard cap.
# KOOKR_RELAY_SHARE_MAX_TTL_MS=2678400000
KOOKR_RELAY_SHARE_CREATE_LIMIT_PER_MINUTE=20
KOOKR_RELAY_ACCOUNT_PAIR_LIMIT_PER_MINUTE=10
KOOKR_RELAY_METADATA_RETENTION_DAYS=30
KOOKR_RELAY_REQUEST_BODY_LIMIT_BYTES=1000000
KOOKR_RELAY_TRUSTED_PROXY=1

# This release only warns for non-loopback binds. Keep unset for loopback deployments.
# KOOKR_RELAY_ALLOW_INSECURE_BIND=1
