# Kookr local environment template.
# See docs/reference/environment-variables.md for the full reference.
#
# Copy this file to .env and uncomment only the settings you need.

# Server
# KOOKR_PORT=4800
# KOOKR_HOST=127.0.0.1

# Agent binaries
# KOOKR_AGENT_BIN=claude
# KOOKR_CODEX_BIN=codex
# KOOKR_PLUGIN_DIR=./plugin
# KOOKR_BACKEND=dtach

# Permission bypass - removes important safety guardrails.
# KOOKR_BYPASS_ALL_PERMISSIONS=true

# Optional LLM credentials
# AI features such as task naming, response assist, and remote-chat rephrase
# use the first configured provider from GROQ, GEMINI, then ANTHROPIC.
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...

# Remote chat trigger (Telegram) - off by default.
# Setup:
# 1. Talk to @BotFather, create a bot, and copy its token.
# 2. DM your bot, then find your numeric Telegram user ID at:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. Set the bot token, allowed user IDs, and allowed project paths below.
# 4. Start with dry-run enabled for the first day or two.
# 5. Restart Kookr with pnpm prod:restart, pnpm dev, or pnpm start.
# Panic switch: KOOKR_REMOTE_CHAT_DISABLED=1
# Tip: send "/task <prompt>" to bypass LLM rephrase.
# KOOKR_TELEGRAM_BOT_TOKEN=<from BotFather>
# KOOKR_TELEGRAM_ALLOWED_USERS=1234567
# KOOKR_REMOTE_CHAT_PROJECTS=/home/jean/git/kookr
# KOOKR_REMOTE_CHAT_DRY_RUN=1
# KOOKR_REMOTE_CHAT_DISABLED=1

# Speech IO - off by default. Bundled STT/TTS run via Docker Compose.
# STT auto-detects an NVIDIA runtime and falls back to CPU otherwise, so
# KOOKR_STT=true works on Mac, AMD, and CPU-only Linux without manual edits.
# First boot downloads the Whisper model (~150 MB on CPU, ~3 GB on GPU).
# See README "Voice (optional)" and docs/reference/environment-variables.md.
# KOOKR_STT=true
# KOOKR_STT_URL=ws://127.0.0.1:8003
# KOOKR_STT_PORT=8003
# KOOKR_TTS=true
# KOOKR_TTS_URL=http://127.0.0.1:8004
# KOOKR_TTS_PORT=8004

# STT inference device - auto (default) | cpu | gpu.
# `auto` probes `docker info` for an nvidia runtime; force `cpu` or `gpu`
# to override (e.g. on a GPU box where the runtime is registered but you
# want CPU for testing).
# KOOKR_STT_DEVICE=auto

# STT model overrides (advanced). The manager picks sensible defaults for
# the resolved device — CPU: latest-cpu / base / int8; GPU: latest-cuda /
# large-v3 / float16. Set any of these to override.
# WHISPER_IMAGE=fedirz/faster-whisper-server:latest-cuda
# WHISPER_MODEL=large-v3
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16

# TTS voice - path inside the kookr-tts container.
# Built-in voices (no HF_TOKEN): /app/voices/{matilda,alba,marius,javert,jean,fantine,cosette,eponine,azelma}.mp3
# Custom voices: drop MP3/WAV files in tts/voices/ and reference as /app/voices/<name>.<ext>.
# TTS_VOICE=/app/voices/matilda.mp3

# Scheduling and recovery
# KOOKR_AUTO_RELAUNCH=false
# KOOKR_NO_CATCHUP=1

# Context and checkpointing
# KOOKR_CHECKPOINT_TRIGGER_RATIO=0.75
# KOOKR_CHECKPOINT_MAX_CANCELLED_ATTEMPTS=3
# KOOKR_CHECKPOINT_CYCLE_DISABLED=1
# KOOKR_CONTEXT_ADVISORY_ENABLED=1
# KOOKR_CONTEXT_ADVISORY_DISABLED=1

# Diagnostics and budgeting
# KOOKR_BUDGET_WARN_USD=5
# KOOKR_AUTO_REFLECT_DISABLE=1

# CLI tools
# KOOKR_SPAWN_MAX_PROMPT_BYTES=1048576
# KOOKR_SPAWN_CONNECT_RETRIES=3

# Production helper scripts
# KOOKR_PROD_DIR=../kookr-prod
# KOOKR_HEALTH_URL=http://127.0.0.1:4800/api/health
# KOOKR_STARTUP_TIMEOUT_SECONDS=720
# KOOKR_STARTUP_CHECK_INTERVAL_SECONDS=2

# Hook/script overrides
# KOOKR_HOOKS_DIR=~/.kookr
# KOOKR_DTACH_SOCK_DIR=/tmp/kookr-dtach/$(id -u)
# KOOKR_API_BASE_URL=http://127.0.0.1:4800
