# Kookr local environment template.
# See docs/reference/environment-variables.md for the full reference.
#
# Copy this file to .env and uncomment only the settings you need.

# Server
# KOOKR_PORT=4800
# KOOKR_HOST=127.0.0.1

# Non-loopback API authentication (issue #708).
# Only relevant when KOOKR_HOST is a non-loopback address (a LAN IP or 0.0.0.0).
# Loopback binds (127.0.0.1/::1/localhost) stay completely token-free.
#   - Set KOOKR_API_TOKEN to require a bearer token on state-changing requests
#     and WebSocket upgrades. The kookr spawn / kookr status CLIs send it too,
#     but read it from the exported environment (they do not load this .env).
#     Non-loopback binds reject operator-provided tokens shorter than 24 chars.
#   - Or set KOOKR_ALLOW_NON_LOOPBACK=true to auto-generate + print a token at
#     startup. With neither set, a non-loopback bind refuses to start.
# KOOKR_API_TOKEN=replace-with-a-long-random-secret
# KOOKR_ALLOW_NON_LOOPBACK=true
# KOOKR_ALLOW_WEAK_API_TOKEN=true

# Optional admin token for /api/admin/* routes from non-loopback callers.
# Loopback admin requests are trusted without this token.
# KOOKR_ADMIN_TOKEN=<local-admin-secret>

# Retention window (ms) for the read-only share-grant store: revoked/expired
# viewer grants are compacted out of share-grants.json once their terminal
# timestamp is older than this. Default 30 days; 0 prunes immediately.
# KOOKR_SHARE_GRANT_RETENTION_MS=2592000000

# Retention window (ms) for terminal (merged/closed) rows in oss-attempts.json.
# Active scouted/pr_open rows are never removed. Default 90 days; 0 prunes
# every terminal attempt immediately. Does not rewrite contribution-ledger.jsonl.
# KOOKR_OSS_ATTEMPT_RETENTION_MS=7776000000

# Optional bearer token gating the supervisor mutating endpoints (issue #1526
# Phase B): POST /api/tasks/:id/complete, POST /api/tasks/abort,
# POST /api/tasks/completion-ready/ack-all. Unlike KOOKR_ADMIN_TOKEN there is
# no loopback bypass — the token is required even from localhost.
# KOOKR_SUPERVISOR_TOKEN=<local-supervisor-secret>

# Emergency escape hatch for loopback browser-origin enforcement.
# Headerless CLI/curl/hook requests do not need this.
# KOOKR_DISABLE_ORIGIN_GATE=true

# Agent binaries
# KOOKR_AGENT_BIN=claude
# KOOKR_CODEX_BIN=codex
# Default Codex model for Kookr-fork launches (Sol). Override to Luna or another
# fork-supported model id. Explicit --effort ultra always uses gpt-5.6-sol.
# KOOKR_CODEX_MODEL=gpt-5.6-sol
# KOOKR_GROK_BIN=grok
# KOOKR_PLUGIN_DIR=./plugin
# KOOKR_BACKEND=dtach

# Worktree cleanup safety — comma-separated branches require explicit
# confirmation for user-initiated cleanup and are always blocked automatically.
KOOKR_PROTECTED_BRANCHES=main,master,develop,dev

# Grok Build (issue #1339). Registered by default like the other agents and
# shown in the agent picker / round robin; a missing binary degrades to a
# preflight warning. Build qualification against the reviewed compatibility
# manifest is ADVISORY: unqualified builds launch with a supervision warning.
# Chat access needs an entitled account — otherwise launch readiness reports
# the HTTP error.
# KOOKR_GROK_MODEL=grok-4.5
# New-launch kill switch (halts new Grok launches without a restart):
# KOOKR_GROK_BUILD_DISABLE_NEW_LAUNCHES=true
# Override the reviewed build-qualification manifest path (defaults to the in-repo one):
# KOOKR_GROK_COMPAT_MANIFEST=/path/to/grok-build-compatibility.v1.json

# Permission bypass - removes important safety guardrails.
# KOOKR_BYPASS_ALL_PERMISSIONS=true

# Optional LLM credentials
# AI features such as task naming, response assist, and remote-chat rephrase
# use a configurable LLM provider. With KOOKR_LLM_PROVIDER unset (auto), Kookr
# chains every configured provider for fallback: GROQ, GEMINI, ANTHROPIC, then
# OPENROUTER. Requesty is explicit-only and is not part of auto.
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...
#
# OpenRouter (paid, OpenAI-compatible) — defaults to deepseek/deepseek-v4-flash.
# KOOKR_OPENROUTER_API_KEY is preferred so a separate OpenRouter credit limit
# can be scoped to Kookr; OPENROUTER_API_KEY works for simple single-key setups.
# KOOKR_OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_API_KEY=sk-or-...
#
# Requesty (paid, OpenAI-compatible gateway) — explicit-only.
# KOOKR_LLM_PROVIDER=requesty
# KOOKR_REQUESTY_API_KEY=req_...
# REQUESTY_API_KEY=req_...
# KOOKR_REQUESTY_MODEL=openai/gpt-4o-mini
#
# Baseten (OpenAI-compatible Model APIs) — explicit-only. Defaults to model
# nvidia/Nemotron-120B-A12B at https://inference.baseten.co/v1.
# KOOKR_LLM_PROVIDER=baseten
# KOOKR_BASETEN_API_KEY=...             # or BASETEN_API_KEY
# KOOKR_BASETEN_MODEL=nvidia/Nemotron-120B-A12B
# KOOKR_BASETEN_BASE_URL=https://inference.baseten.co/v1
#
# Pin one provider instead of the auto fallback chain:
# KOOKR_LLM_PROVIDER=openrouter        # openrouter | requesty | baseten | groq | gemini | anthropic | auto
# KOOKR_LLM_MODEL=deepseek/deepseek-v4-flash   # OpenRouter model id
# KOOKR_LLM_BASE_URL=https://openrouter.ai/api/v1
# KOOKR_LLM_HTTP_REFERER=https://your-app.example   # optional app attribution
# KOOKR_LLM_APP_TITLE=Kookr                          # optional app attribution
# KOOKR_LLM_TIMEOUT_MS=20000   # explicit OpenRouter timeout (ms); else caller budgets are floored to 20s
# KOOKR_LLM_AUTH_COOLDOWN_MS=1800000  # skip auth-failed providers for 30m (0 disables); see diagnostics pausedProviders
#
# Note: these LLM provider settings are independent of the local speech
# STT/TTS models (KOOKR_STT*, KOOKR_TTS*, WHISPER_*) configured further below.

# Remote chat trigger (Telegram) - off by default.
# Setup:
# 1. Talk to @BotFather, create a bot, and copy its token.
# 2. DM your bot, then find your numeric Telegram user ID at:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. Set the bot token, allowed user IDs, and allowed project paths below.
# 4. Start with dry-run enabled for the first day or two.
# 5. Restart Kookr with pnpm prod:restart, pnpm dev, or pnpm start.
# Panic switch: KOOKR_REMOTE_CHAT_DISABLED=1
# Tip: send "/task <prompt>" to bypass LLM rephrase.
# KOOKR_TELEGRAM_BOT_TOKEN=<from BotFather>
# KOOKR_TELEGRAM_ALLOWED_USERS=1234567
# KOOKR_REMOTE_CHAT_PROJECTS=$HOME/git/kookr
# KOOKR_REMOTE_CHAT_DASHBOARD_URL=https://kookr.example.com
# KOOKR_REMOTE_CHAT_DRY_RUN=1
# KOOKR_REMOTE_CHAT_DISABLED=1

# Outbound finding webhook - off by default.
# Sends a generic JSON POST when findings enter the attention queue.
# URL must be public http(s). Private/LAN/loopback need KOOKR_WEBHOOK_ALLOW_PRIVATE;
# cloud metadata and link-local hosts are always rejected (even with the opt-in).
# KOOKR_WEBHOOK_URL=https://example.com/kookr-findings
# KOOKR_WEBHOOK_ALLOW_PRIVATE=1
# KOOKR_WEBHOOK_MIN_SEVERITY=warning

# Operator signal delivery (issue #1716) - off by default.
# Pushes alert/clear signals (deploy-lag, prod-smoke, liveness) to Discord
# and/or Telegram. Configure at least one channel to enable. Signals are
# deduped by file name, batched to <=1 message/min, and survive restarts.
# Discord: a public https incoming-webhook URL (same host policy as KOOKR_WEBHOOK_URL —
# private/LAN/loopback need KOOKR_WEBHOOK_ALLOW_PRIVATE; metadata/link-local always rejected).
# KOOKR_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# Telegram: a numeric chat id (reuses KOOKR_TELEGRAM_BOT_TOKEN above).
# KOOKR_SIGNAL_TELEGRAM_CHAT_ID=1234567
# Start with dry-run to see formatted batches in the log without POSTing.
# KOOKR_SIGNAL_DELIVERY_DRY_RUN=1
# Tuning (defaults shown): poll cadence and min spacing between messages.
# KOOKR_SIGNAL_DELIVERY_POLL_MS=15000
# KOOKR_SIGNAL_DELIVERY_MIN_SEND_MS=60000
# Override the outbox directory (default ~/.kookr/playbook-state/operator-signals).
# KOOKR_OPERATOR_SIGNAL_DIR=

# Speech IO - off by default. Bundled STT/TTS run via Docker Compose.
# STT auto-detects an NVIDIA runtime and falls back to CPU otherwise, so
# KOOKR_STT=true works on Mac, AMD, and CPU-only Linux without manual edits.
# First boot downloads the Whisper model (~150 MB on CPU, ~3 GB on GPU).
# See README "Voice (optional)" and docs/reference/environment-variables.md.
# KOOKR_STT=true
# KOOKR_STT_URL=ws://127.0.0.1:8003
# KOOKR_STT_PORT=8003
# KOOKR_TTS=true
# KOOKR_TTS_URL=http://127.0.0.1:8004
# KOOKR_TTS_PORT=8004

# STT inference device - auto (default) | cpu | gpu.
# `auto` probes `docker info` for an nvidia runtime; force `cpu` or `gpu`
# to override (e.g. on a GPU box where the runtime is registered but you
# want CPU for testing).
# KOOKR_STT_DEVICE=auto

# TTS inference device - auto (default) | cpu | gpu.
# `auto` probes `docker info` for an nvidia runtime; force `cpu` or `gpu`
# to override.
# KOOKR_TTS_DEVICE=auto

# STT model overrides (advanced). The manager picks sensible defaults for
# the resolved device — CPU: latest-cpu / base / int8; GPU: latest-cuda /
# large-v3 / float16. Set any of these to override.
# WHISPER_IMAGE=fedirz/faster-whisper-server:latest-cuda
# WHISPER_MODEL=large-v3
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16

# TTS voice - built-in voice name or path inside the kookr-tts container.
# Built-in voices (no HF_TOKEN): alba, marius, javert, jean, fantine, cosette, eponine, azelma
# Bundled/custom voices: add MP3/WAV files to tts/voices/ before building and reference as /app/voices/<name>.<ext>.
# TTS_VOICE=/app/voices/matilda.mp3

# TTS model tuning (advanced). Read by the Python Pocket TTS sidecar at model
# load (tts/src/server.py), not by the TypeScript process. Defaults match the
# sidecar when unset. See docs/reference/environment-variables.md.
# TTS_MODEL_TEMPERATURE=0.7
# TTS_MODEL_LSD_STEPS=1
# TTS_MODEL_EOS_THRESHOLD=-4.0
# TTS_MODEL_NOISE_CLAMP=

# Scheduling and recovery
# KOOKR_AUTO_RELAUNCH=false
# KOOKR_AUTO_CATCHUP=1
# KOOKR_NO_CATCHUP=1

# Context window
# KOOKR_CONTEXT_ADVISORY_ENABLED=1
# KOOKR_CONTEXT_ADVISORY_DISABLED=1

# Diagnostics and budgeting
# KOOKR_BUDGET_WARN_USD=25
# KOOKR_AUTO_REFLECT_DISABLE=1

# Operational alerts on host/resource signals and dependency breakers.
# Each threshold of 0 disables that rule. CPU/memory/event-loop/process-RSS are
# opt-in; data-directory disk pressure defaults to warning below 5% or 2 GiB free.
# Sampled resource alerts fire after KOOKR_ALERT_SUSTAIN_SAMPLES consecutive
# samples (~2s apart); circuit-breaker alerts use the OPEN duration threshold.
# All rules clear once on recovery.
# KOOKR_ALERT_CPU_PERCENT=90
# KOOKR_ALERT_MEMORY_PERCENT=90
# KOOKR_ALERT_EVENT_LOOP_DELAY_MS=200
# Alert when the Kookr supervisor process RSS stays at/above this many bytes
# (e.g. 2147483648 = 2 GiB); surfaces the process "fattening" before host OOM.
# KOOKR_ALERT_PROCESS_RSS_BYTES=2147483648
# KOOKR_ALERT_DATA_DIR_FREE_PERCENT=5
# KOOKR_ALERT_DATA_DIR_FREE_BYTES=2147483648
# KOOKR_ALERT_CIRCUIT_BREAKER_OPEN_MS=30000
# KOOKR_ALERT_SUSTAIN_SAMPLES=3

# CPU-aware task admission (issue #1630). Reject new task launches while the
# host 1-minute load average per logical CPU exceeds this value, so a burst of
# compile/test-heavy tasks cannot saturate the shared host and starve the
# supervisor event loop (maxActiveTasks bounds task COUNT, not aggregate CPU).
# 0 (the default) disables the gate. On a busy shared host ~0.9-1.0 rejects
# once average load reaches the core count. Schedule-fired launches are exempt.
# KOOKR_MAX_HOST_LOAD_PER_CPU=0

# Finding-evidence review diagnostics - off by default.
# Requires an LLM provider and a positive daily budget before any model call.
# KOOKR_FINDING_REVIEW_ENABLED=true
# KOOKR_FINDING_REVIEW_DAILY_COST_CENTS=10
# KOOKR_FINDING_REVIEW_ADMIN_TOKEN=<local-admin-secret>
# KOOKR_FINDING_REVIEW_TOKEN=<csrf-secret>
#
# Background finding-evidence review sampler - off by default.
# KOOKR_FINDING_REVIEW_SAMPLER_ENABLED=true
# KOOKR_FINDING_REVIEW_SAMPLER_INTERVAL_MS=900000
# KOOKR_FINDING_REVIEW_SAMPLER_MAX_PER_INTERVAL=3
# KOOKR_FINDING_REVIEW_SAMPLER_MAX_PER_DETECTOR=1
# See docs/reference/environment-variables.md for advanced sampler limits,
# retry, lease, and candidate threshold settings.

# CLI tools
# KOOKR_SPAWN_MAX_PROMPT_BYTES=1048576
# KOOKR_SPAWN_CONNECT_RETRIES=3
# KOOKR_SPAWN_REDEPLOY_WAIT_MS=45000

# Production helper scripts
# KOOKR_PROD_DIR=../kookr-prod
# KOOKR_HEALTH_URL=http://127.0.0.1:4800/api/health
# KOOKR_STARTUP_TIMEOUT_SECONDS=720
# KOOKR_STARTUP_CHECK_INTERVAL_SECONDS=2

# Hook/script overrides
# KOOKR_HOOKS_DIR=~/.kookr
# KOOKR_DTACH_SOCK_DIR=/tmp/kookr-dtach/$(id -u)
# KOOKR_API_BASE_URL=http://127.0.0.1:4800

# Hook event-log rotation (issue #1433). The active per-session hook JSONL file
# is size-rotated into <session>.jsonl.N generations so it cannot grow unbounded
# and starve hook ingestion. Set KOOKR_HOOK_MAX_BYTES<=0 to disable rotation.
# KOOKR_HOOK_MAX_BYTES=33554432
# KOOKR_HOOK_ROTATE_KEEP=4

# Lesson-write spool recovery loop (issue #1519). Default on (empty/unset);
# set 0 to disable the background probe/drain/alert (PATH shim + kookr lesson
# CLI still work). Left uncommented so the anti-drift env gate can see it.
KOOKR_LESSON_SPOOL=
# Lesson-decision gate on completion-ready (issue #1538). Default on when
# unset. Set to 0/false/off/no to disable (emergency / hermetic tests only).
# Left uncommented so the anti-drift env gate can see it.
KOOKR_LESSON_DECISION_GATE=
# Merge-required gate on completion-ready (issue #1836). Default on when
# unset. Set to 0/false/off/no to disable (emergency / hermetic tests only).
# Left uncommented so the anti-drift env gate can see it.
KOOKR_MERGE_REQUIRED_GATE=
# Live gh pr view mergedAt probes for the merge-required gate (issue #1836).
# Default on outside Vitest; set 0/false/off/no for trail-only verification.
KOOKR_MERGE_REQUIRED_LIVE_VERIFY=

# Agent signal outbox drain (issue #1541). Default on (empty/unset); set 0 to
# disable the background drain of ~/.kookr/playbook-state/signal-outbox/. The
# CLI still write-behinds signals when the daemon is unreachable.
KOOKR_SIGNAL_OUTBOX=
# KOOKR_SIGNAL_OUTBOX_DIR=

# Durable retro-verify queue (issue #1689). Override the directory where merges
# made while CI was signal-absent are enqueued for re-verification on recovery.
# KOOKR_RETRO_VERIFY_QUEUE_DIR=
