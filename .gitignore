.playwright-mcp/

# Ralph Wiggum loop local files
ralph-loop.local.md
LOOP-PROMPT.md
loop-state.json

# Codex CLI per-project config (created by bwrap sandbox; see #234)
.codex/

# Claude Code worktrees
.claude/worktrees/

# Claude Code local settings (personal permissions/plugins)
.claude/settings.local.json

# Demo video output
demo/output/

# Vendored third-party binaries (built by scripts/build-dtach.sh, etc.)
vendor/

# Local-only marker that the .hooks/pre-push gate validates against.
# Each branch writes its own .review-state/<key>.json before push;
# never commit these.
.review-state/

# kookr-toolkit placement-gate strict-mode sentinel. Presence at the git
# common-dir parent enables hard-block mode for the placement gate plugin
# hook. Always local-only — committing this would force every clone /
# worktree into strict mode silently (per rfc-unified-placement-picker §C).
.kookr-placement-gate-strict

# Graphify per-session artifact directory.
graphify-out/
