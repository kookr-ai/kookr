{
  "name": "kookr",
  "version": "1.0.0",
  "description": "Smart attention router for developers running multiple AI coding agents.",
  "main": "dist/server/start.js",
  "bin": {
    "kookr": "./bin/kookr.js",
    "kookr-spawn": "./bin/kookr-spawn.js",
    "kookr-status": "./bin/kookr-status.js",
    "kookr-ralph": "./bin/kookr-ralph.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "pnpm generate-build-info && pnpm build:dtach && tsc && pnpm build:frontend",
    "build:dtach": "bash scripts/build-dtach.sh",
    "generate-build-info": "node --import tsx scripts/generate-build-info.ts",
    "build:server": "tsc",
    "check:e2e": "tsc -p tsconfig.e2e.json",
    "build:frontend": "vite build",
    "start": "node dist/server/start.js",
    "start:dev": "KOOKR_PORT=4801 node dist/server/start.js",
    "status": "node bin/kookr-status.js",
    "dev": "KOOKR_PORT=4801 node --import tsx --watch-path=src/server --watch-path=src/core --watch-path=src/adapters src/server/start.ts & vite & wait",
    "dev:server": "KOOKR_PORT=4801 node --import tsx --watch-path=src/server --watch-path=src/core --watch-path=src/adapters src/server/start.ts",
    "dev:frontend": "vite",
    "prod:setup": "git worktree add --detach ../kookr-prod HEAD && cd ../kookr-prod && pnpm install && pnpm build",
    "prod:update": "bash scripts/prod-update.sh",
    "prod:restart": "ROOT_DIR=$(pwd) && cd ../kookr-prod && bash \"$ROOT_DIR/scripts/prod-restart.sh\"",
    "telemetry:report": "node --import tsx scripts/telemetry-report.ts",
    "shadow:report": "node --import tsx scripts/shadow-report.ts",
    "test:onboarding": "bash scripts/onboarding-smoke-test.sh",
    "test:hooks": "for t in .claude/hooks-tests/*.test.sh; do echo \"== $t ==\"; bash \"$t\" || exit 1; done",
    "demo:record": "pnpm build && node --import tsx demo/record.ts",
    "codex:rebuild": "bash scripts/rebuild-codex.sh",
    "prepare": "git config core.hooksPath .hooks && pnpm build:dtach"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.2",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@google/genai": "^1.47.0",
    "@hono/node-server": "^1.19.11",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "cron-parser": "^5.5.0",
    "groq-sdk": "^1.1.2",
    "hono": "^4.12.9",
    "node-pty": "^1.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ws": "^8.20.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-pty",
      "protobufjs"
    ]
  }
}
