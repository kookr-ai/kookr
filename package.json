{
  "name": "kookr",
  "version": "1.0.0",
  "description": "Smart attention router for developers running multiple AI coding agents.",
  "main": "dist/server/start.js",
  "bin": {
    "kookr": "./bin/kookr.js",
    "kookr-spawn": "./bin/kookr-spawn.js",
    "kookr-status": "./bin/kookr-status.js",
    "kookr-ralph": "./bin/kookr-ralph.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "CLAUDE.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/main",
    "verify": "bash scripts/verify.sh",
    "test:smoke": "pnpm build:frontend && node --import tsx scripts/check-remote-import-boundaries.ts && vitest run src/remote/__tests__/load-purity.test.ts src/server/session-bridge.test.ts && node --import tsx scripts/local-only-smoke.ts",
    "test:e2e:relay": "vitest run relay/__tests__/two-nodes.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "pnpm generate-build-info && pnpm build:dtach && pnpm build:server && pnpm build:relay && pnpm build:frontend",
    "build:dtach": "bash scripts/build-dtach.sh",
    "fix:native-perms": "bash scripts/fix-native-perms.sh",
    "doctor": "bash scripts/doctor.sh",
    "check:portability": "bash scripts/check-portability.sh && bash scripts/check-shell-portability.sh",
    "relay:start": "node --import tsx scripts/relay-lifecycle.ts start",
    "relay:status": "node --import tsx scripts/relay-lifecycle.ts status",
    "relay:logs": "node --import tsx scripts/relay-lifecycle.ts logs",
    "relay:restart": "node --import tsx scripts/relay-lifecycle.ts restart",
    "relay:stop": "node --import tsx scripts/relay-lifecycle.ts stop",
    "relay:doctor": "node --import tsx scripts/relay-lifecycle.ts doctor",
    "generate-build-info": "node --import tsx scripts/generate-build-info.ts",
    "build:server": "tsc",
    "build:relay": "tsc -p tsconfig.relay.json",
    "check:e2e": "tsc -p tsconfig.e2e.json",
    "build:frontend": "vite build",
    "start": "pnpm build:dtach && node dist/server/start.js",
    "start:dev": "pnpm build:dtach && KOOKR_PORT=4801 node dist/server/start.js",
    "status": "node bin/kookr.js status",
    "dev": "pnpm build:dtach && bash scripts/dev-processes.sh dev",
    "dev:server": "pnpm build:dtach && KOOKR_PORT=4801 node --import tsx --watch-path=src/server --watch-path=src/core --watch-path=src/adapters --watch-path=src/shared --watch-path=src/remote --watch-path=src/integrations src/server/start.ts",
    "dev:frontend": "vite",
    "dev:demo": "bash scripts/dev-processes.sh demo",
    "prod:setup": "git worktree add --detach ../kookr-prod HEAD && if [ -f .env ]; then ln -sfn \"$(pwd)/.env\" ../kookr-prod/.env; fi && cd ../kookr-prod && pnpm install && pnpm build",
    "prod:update": "bash scripts/prod-update.sh",
    "prod:restart": "ROOT_DIR=$(pwd) && cd ../kookr-prod && bash \"$ROOT_DIR/scripts/prod-restart.sh\"",
    "prod:logs": "bash scripts/prod-logs.sh",
    "telemetry:report": "node --import tsx scripts/telemetry-report.ts",
    "kb:usage": "node --import tsx scripts/kb-usage-report.ts",
    "coverage:summary": "node --import tsx scripts/coverage-summary.ts coverage/coverage-summary.json",
    "shadow:report": "node --import tsx scripts/shadow-report.ts",
    "test:onboarding": "bash scripts/onboarding-smoke-test.sh",
    "validate:skills": "node --import tsx scripts/validate-skills.ts",
    "validate:playbooks": "node --import tsx scripts/validate-playbooks.ts",
    "validate:requirements": "node scripts/validate-requirements-status.mjs",
    "test:hooks": "bash scripts/run-hook-tests.sh",
    "validate:docs-commands": "node --import tsx scripts/verify-documented-commands.ts",
    "validate:docs-env-vars": "node --import tsx scripts/verify-documented-env-vars.ts",
    "demo:record": "pnpm build && node --import tsx demo/record.ts",
    "demo:check": "pnpm build && DEMO_CHECK=1 node --import tsx demo/record.ts",
    "codex:rebuild": "bash scripts/rebuild-codex.sh",
    "grok:rebuild": "bash scripts/rebuild-grok.sh",
    "merge": "bash scripts/kookr-merge.sh",
    "prepare": "git config core.hooksPath .hooks && pnpm build:dtach && pnpm fix:native-perms"
  },
  "keywords": [],
  "author": "Jean Ibarz",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@google/genai": "^2.10.0",
    "@hono/node-server": "^2.0.8",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.6.1",
    "groq-sdk": "^1.3.0",
    "hono": "^4.12.28",
    "node-pty": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
