@@ -2,3 +2,118 @@
 export function clamp(n, lo, hi) {
   return Math.min(Math.max(n, lo), hi);
 }
+
+function swap(a, i, j) {
+  if (i === j) return;
+  const t = a[i];
+  a[i] = a[j];
+  a[j] = t;
+}
+
+function insertionSortRange(a, lo, hi) {
+  for (let i = lo + 1; i <= hi; i++) {
+    const v = a[i];
+    let j = i - 1;
+    while (j >= lo && a[j] > v) {
+      a[j + 1] = a[j];
+      j--;
+    }
+    a[j + 1] = v;
+  }
+}
+
+// Returns the index range [left, right] of elements equal to pivotValue
+// after three-way partitioning a[lo..hi] around pivotValue.
+function partitionAroundPivot(a, lo, hi, pivotValue) {
+  let left = lo;
+  let right = hi;
+  let i = lo;
+  while (i <= right) {
+    const v = a[i];
+    if (v < pivotValue) {
+      swap(a, left, i);
+      left++;
+      i++;
+    } else if (v > pivotValue) {
+      swap(a, right, i);
+      right--;
+    } else {
+      i++;
+    }
+  }
+  return [left, right];
+}
+
+// Median of a[lo..lo+4] using an optimal comparison network; returns the
+// median value without relying on the surrounding range being sorted.
+function medianOfFive(a, lo) {
+  if (a[lo] > a[lo + 1]) swap(a, lo, lo + 1);
+  if (a[lo + 3] > a[lo + 4]) swap(a, lo + 3, lo + 4);
+  if (a[lo] > a[lo + 3]) {
+    swap(a, lo, lo + 3);
+    swap(a, lo + 1, lo + 4);
+  }
+  if (a[lo + 2] > a[lo + 4]) swap(a, lo + 2, lo + 4);
+  if (a[lo + 1] > a[lo + 3]) swap(a, lo + 1, lo + 3);
+  if (a[lo + 2] > a[lo + 3]) {
+    swap(a, lo + 2, lo + 3);
+    swap(a, lo + 3, lo + 4);
+  }
+  return a[lo + 2];
+}
+
+// Iterative median-of-medians selection of the k-th smallest element.
+// Guarantees O(n) worst-case time. It reorders a[lo..hi] in place, so the
+// caller is responsible for restoring the original order afterwards.
+function selectKthInPlace(a, k, lo, hi) {
+  while (true) {
+    if (k < lo || k > hi) return undefined;
+    if (hi - lo + 1 <= 5) {
+      insertionSortRange(a, lo, hi);
+      return a[k];
+    }
+    let medianCount = 0;
+    for (let start = lo; start + 4 <= hi; start += 5) {
+      const m = medianOfFive(a, start);
+      a[lo + medianCount] = m;
+      medianCount++;
+    }
+    const pivotValue = selectKthInPlace(
+      a,
+      lo + (medianCount >> 1),
+      lo,
+      lo + medianCount - 1
+    );
+    const [left, right] = partitionAroundPivot(a, lo, hi, pivotValue);
+    if (k < left) hi = left - 1;
+    else if (k > right) lo = right + 1;
+    else return pivotValue;
+  }
+}
+
+export function median(values) {
+  if (!Array.isArray(values)) {
+    throw new TypeError('median expects an array');
+  }
+  const n = values.length;
+  if (n === 0) {
+    throw new RangeError('median of an empty array is undefined');
+  }
+  for (let i = 0; i < n; i++) {
+    if (!Number.isFinite(values[i])) {
+      throw new RangeError('median expects only finite numbers');
+    }
+  }
+  const snapshot = values.slice();
+  const mid = n >> 1;
+  try {
+    if (n % 2 === 1) {
+      return selectKthInPlace(values, mid, 0, n - 1);
+    }
+    const lower = selectKthInPlace(values, mid - 1, 0, n - 1);
+    const upper = selectKthInPlace(values, mid, 0, n - 1);
+    return (lower + upper) / 2;
+  } finally {
+    for (let i = 0; i < n; i++) values[i] = snapshot[i];
+  }
+}
