{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kookr.ai/schemas/memory-write-candidates.v1.json",
  "title": "memory-write-candidates.v1",
  "description": "Review-only durable memory write candidates carried in a Kookr checkpoint directory. Kookr preserves this file across checkpoint/resume but does not promote entries automatically.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "candidates"],
  "properties": {
    "schema_version": {
      "const": "memory-write-candidates.v1"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "target",
          "evidence",
          "verifier",
          "approval",
          "lifecycle",
          "promotion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "object",
            "description": "Destination candidate such as a KB, wisdom store, skill, or other durable memory surface.",
            "additionalProperties": true
          },
          "evidence": {
            "type": "array",
            "items": {}
          },
          "verifier": {
            "type": "object",
            "additionalProperties": true,
            "required": ["status"],
            "properties": {
              "status": {
                "enum": ["unverified", "passed", "failed"]
              }
            }
          },
          "approval": {
            "type": "object",
            "additionalProperties": true,
            "required": ["status"],
            "properties": {
              "status": {
                "enum": ["pending", "approved", "rejected"]
              }
            }
          },
          "lifecycle": {
            "type": "object",
            "additionalProperties": true,
            "required": ["status", "created_at"],
            "properties": {
              "status": {
                "enum": ["proposed", "ready_for_review", "promoted", "rejected", "superseded"]
              },
              "created_at": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "promotion": {
            "type": "object",
            "description": "Promotion metadata only. Presence here is not permission for automatic promotion.",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
