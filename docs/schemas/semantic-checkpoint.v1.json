{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kookr.ai/schemas/semantic-checkpoint.v1.json",
  "title": "semantic-checkpoint.v1",
  "description": "Structured Kookr checkpoint written alongside CHECKPOINT.md for durable task handoff and resume.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "task_id",
    "repo",
    "worktree",
    "branch",
    "verdict",
    "decisions",
    "evidence",
    "files_changed",
    "tests_run",
    "open_risks",
    "next_actions",
    "memory_write_candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "semantic-checkpoint.v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1,
      "description": "Repository identity, preferably owner/name when available."
    },
    "worktree": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": ["in_progress", "blocked", "stalled", "complete"]
    },
    "decisions": {
      "type": "array",
      "items": {}
    },
    "evidence": {
      "type": "array",
      "items": {}
    },
    "files_changed": {
      "type": "array",
      "items": {}
    },
    "tests_run": {
      "type": "array",
      "items": {}
    },
    "open_risks": {
      "type": "array",
      "items": {}
    },
    "next_actions": {
      "type": "array",
      "items": {}
    },
    "memory_write_candidates": {
      "type": "array",
      "items": {}
    }
  }
}
