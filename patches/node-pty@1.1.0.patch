+/**
+ * Close-on-exec FD.
+ *
+ * The pty master fd is retained by the host process to read/write the
+ * terminal. Without FD_CLOEXEC it is inherited by every unrelated child the
+ * host spawns afterwards (e.g. a detached multiplexer such as dtach), which
+ * pins the pty open long after its own session ends and prevents the kernel
+ * from reclaiming it. Marking the master close-on-exec is transparent to the
+ * host's own use of the fd and stops the leak at the source.
+ */
+static int
+pty_cloexec(int fd) {
+  int flags = fcntl(fd, F_GETFD, 0);
+  if (flags == -1) return -1;
+  return fcntl(fd, F_SETFD, flags | FD_CLOEXEC);
+}
