{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kookr: Launch + debug dev server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--import",
        "tsx",
        "--watch-path=src/server",
        "--watch-path=src/core",
        "--watch-path=src/adapters"
      ],
      "program": "${workspaceFolder}/src/server/start.ts",
      "env": {
        "KOOKR_PORT": "4801"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "restart": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Kookr: Attach to dev server",
      "type": "node",
      "request": "attach",
      "cwd": "${workspaceFolder}",
      "address": "localhost",
      "port": 9229,
      "restart": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Kookr: Debug current Vitest file",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": [
        "run",
        "${file}"
      ],
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "smartStep": true,
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Kookr: Server and current test",
      "configurations": [
        "Kookr: Launch + debug dev server",
        "Kookr: Debug current Vitest file"
      ],
      "stopAll": true
    }
  ]
}
