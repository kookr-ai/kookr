{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; \"$root/hooks/kookr-prod-kill-guard.sh\"'"
          }
        ]
      }
    ]
  }
}
